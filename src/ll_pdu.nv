// orbit/noble-radio/src/ll_pdu.nv — the legacy advertising channel PDUs: the header
// bits, a fixed buffer for one PDU, and the builders and parsers of the
// seven PDU types the legacy Link Layer sends and receives.
//
// [Vol 6] Part B, Section 2.3: an advertising channel PDU is a 2-octet
// header and a payload of 0 to 37 octets.  Octet 0 of the header holds the
// PDU Type in bits 0 to 3, ChSel in bit 5, TxAdd in bit 6 and RxAdd in bit 7;
// octet 1 holds the payload length.  The radio's S0 field is octet 0 and its
// LENGTH field is octet 1, so a `Pdu` is the bytes the radio sends or fills,
// header first.
//
// An address is 6 octets, least significant octet first, as HCI and the air
// carry it.
//
// The state is a value with inline storage; no function here allocates.

use std.test

// The functions below take a PDU as a `var` parameter even where they only read
// it, which passes its address.  A plain parameter is a copy, and a copy of a
// struct of this size on every call costs time and stack.

// PDU types, [Vol 6] Part B, Section 2.3.
pub const ADV_IND = 0
pub const ADV_DIRECT_IND = 1
pub const ADV_NONCONN_IND = 2
pub const SCAN_REQ = 3
pub const SCAN_RSP = 4
pub const CONNECT_IND = 5
pub const ADV_SCAN_IND = 6

// The longest payload of a legacy advertising PDU, and the octets of a PDU
// with the header.
pub const PAYLOAD_MAX = 37
pub const PDU_OCTETS = 39

// The octets of the payloads that have a fixed size: an address, SCAN_REQ
// (ScanA and AdvA), ADV_DIRECT_IND (AdvA and TargetA) and CONNECT_IND
// (InitA, AdvA and the 22 octets of LLData).
pub const ADDR_OCTETS = 6
pub const SCAN_REQ_PAYLOAD = 12
pub const DIRECT_PAYLOAD = 12
pub const CONNECT_PAYLOAD = 34

// The most advertising or scan response data octets a legacy PDU carries.
pub const DATA_MAX = 31

// The header bits.  ChSel says the sender supports channel selection algorithm #2
// (an advertisement) or that the connection uses it (a CONNECT_IND).
pub const CHSEL = 0x20
pub const TXADD = 0x40
pub const RXADD = 0x80

// Address types as HCI numbers them: public and random.
pub const ADDR_PUBLIC = 0
pub const ADDR_RANDOM = 1

// `b` holds the PDU, header first, in 260 octets: the longest Data Physical
// Channel PDU with the Data Length Extension is a header of 2 octets, a payload of
// 251 and the MIC of 4, 257 octets, rounded up to whole words.  An advertising PDU
// is at most 39 octets (`PDU_OCTETS`).  `n` is the octets written.
@value
pub struct Pdu
    b: Vec[u8; 260]
    n: Int

// The octets a `Pdu` holds.
pub const PDU_CAP = 260

// The octets of the longest data PDU: the header, 251 octets of payload and the MIC.
pub const DATA_OCTETS_MAX = 257

// An empty PDU.
@tier(embedded)
pub fn pdu_new() -> Pdu
    var p = Pdu { b: Vec.new(), n: 0 }
    for _ in 0..260
        let _a = p.b.push(0)
    p

// Back to empty.
@tier(embedded)
pub fn pdu_clear(var p: Pdu)
    p.n = 0

// Append one octet.  False when the PDU is full.
@tier(embedded)
pub fn pdu_put(var p: Pdu, v: Int) -> Bool
    if p.n >= PDU_OCTETS
        return false
    p.b[p.n] = (v & 0xFF) as u8
    p.n = p.n + 1
    true

// Append one octet of a data PDU, which may be longer than an advertising PDU.
// False when the PDU is full.
@tier(embedded)
pub fn pdu_put_data(var p: Pdu, v: Int) -> Bool
    if p.n >= DATA_OCTETS_MAX
        return false
    p.b[p.n] = (v & 0xFF) as u8
    p.n = p.n + 1
    true

// Octet `i` of the PDU, -1 past what was written.
@tier(embedded)
pub fn pdu_get(var p: Pdu, i: Int) -> Int
    if i < 0 or i >= p.n
        -1
    else
        p.b[i] as Int

// Start a PDU of `ty`: the header with the address type bits, and the length
// octet left at zero.  `tx_add` and `rx_add` are 0 or 1.
@tier(embedded)
pub fn pdu_begin(var p: Pdu, ty: Int, tx_add: Int, rx_add: Int)
    p.n = 0
    let _a = pdu_put(var p, ty | (tx_add * TXADD) | (rx_add * RXADD))
    let _b = pdu_put(var p, 0)

// Write the payload length into the header.
@tier(embedded)
pub fn pdu_finish(var p: Pdu)
    if p.n >= 2
        p.b[1] = (p.n - 2) as u8

// Append the six octets of `a`.
@tier(embedded)
pub fn pdu_put_addr(var p: Pdu, var a: Vec[u8; 6])
    for i in 0..ADDR_OCTETS
        let _a = pdu_put(var p, a[i] as Int)

// The PDU Type of a received PDU.
@tier(embedded)
pub fn pdu_type(var p: Pdu) -> Int
    (p.b[0] as Int) & 0x0F

// The payload length the header claims.
@tier(embedded)
pub fn pdu_len(var p: Pdu) -> Int
    (p.b[1] as Int) & 0x3F

// TxAdd and RxAdd, 0 or 1.
@tier(embedded)
pub fn pdu_tx_add(var p: Pdu) -> Int
    if ((p.b[0] as Int) & TXADD) != 0
        1
    else
        0

@tier(embedded)
pub fn pdu_rx_add(var p: Pdu) -> Int
    if ((p.b[0] as Int) & RXADD) != 0
        1
    else
        0

// Whether the six octets at payload offset `off` equal `a`.
@tier(embedded)
pub fn pdu_addr_is(var p: Pdu, off: Int, var a: Vec[u8; 6]) -> Bool
    for i in 0..ADDR_OCTETS
        if p.b[2 + off + i] != a[i]
            return false
    true

// Copy the six octets at payload offset `off` into `a`.
@tier(embedded)
pub fn pdu_addr_get(var p: Pdu, off: Int, var a: Vec[u8; 6])
    for i in 0..ADDR_OCTETS
        a[i] = p.b[2 + off + i]

// Whether a received PDU of type `ty` has a payload length that type allows,
// and the header's length agrees with the octets received (`got`, the PDU
// octets including the header).
@tier(embedded)
pub fn pdu_well_formed(var p: Pdu, got: Int) -> Bool
    if got < 2
        return false
    let len = pdu_len(var p)
    if len + 2 != got
        return false
    let ty = pdu_type(var p)
    if ty == ADV_IND or ty == ADV_SCAN_IND or ty == ADV_NONCONN_IND or ty == SCAN_RSP
        return len >= ADDR_OCTETS and len <= PAYLOAD_MAX
    if ty == ADV_DIRECT_IND
        return len == DIRECT_PAYLOAD
    if ty == SCAN_REQ
        return len == SCAN_REQ_PAYLOAD
    if ty == CONNECT_IND
        return len == CONNECT_PAYLOAD
    false

// Whether the type is one an advertiser sends on the advertising channels.
@tier(embedded)
pub fn type_is_advertising(ty: Int) -> Bool
    ty == ADV_IND or ty == ADV_DIRECT_IND or ty == ADV_NONCONN_IND or ty == ADV_SCAN_IND

// Whether a scanner answers the type with a SCAN_REQ.
@tier(embedded)
pub fn type_is_scannable(ty: Int) -> Bool
    ty == ADV_IND or ty == ADV_SCAN_IND

// The HCI advertising report Event_Type of the PDU type: 0 to 4 as
// [Vol 4] Part E, Section 7.7.65.2 numbers them, -1 for a type the report
// does not carry.
@tier(embedded)
pub fn report_event_type(ty: Int) -> Int
    match ty
        0 => 0
        1 => 1
        6 => 2
        2 => 3
        4 => 4
        _ => -1

// The microseconds a PDU of `n` octets (header included) takes on the LE 1M
// PHY: the preamble (1 octet), the access address (4) and the CRC (3), at
// 8 microseconds an octet.
@tier(embedded)
pub fn airtime_us(n: Int) -> Int
    (n + 8) * 8

// ── Tests ───────────────────────────────────────────────────────────

pub fn test_addr(first: Int) -> Vec[u8; 6]
    var a: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _x = a.push((first + i) as u8)
    a

@test
fn test_capacity_matches_the_constants()
    let p = pdu_new()
    test.assert_eq(p.b.capacity(), PDU_CAP)
    test.assert_eq(p.b.len(), PDU_CAP)
    test.assert(PDU_OCTETS <= PDU_CAP)
    test.assert(DATA_OCTETS_MAX <= PDU_CAP)
    test.assert_eq(PAYLOAD_MAX + 2, PDU_OCTETS)

@test
fn test_header_carries_type_and_address_bits()
    var p = pdu_new()
    pdu_begin(var p, ADV_IND, 1, 0)
    test.assert_eq(pdu_type(var p), ADV_IND)
    test.assert_eq(pdu_tx_add(var p), 1)
    test.assert_eq(pdu_rx_add(var p), 0)
    pdu_begin(var p, SCAN_REQ, 0, 1)
    test.assert_eq(pdu_type(var p), SCAN_REQ)
    test.assert_eq(pdu_tx_add(var p), 0)
    test.assert_eq(pdu_rx_add(var p), 1)
    test.assert_eq(pdu_get(var p, 0), 0x83)

@test
fn test_finish_writes_the_payload_length()
    var p = pdu_new()
    var a = test_addr(1)
    pdu_begin(var p, ADV_NONCONN_IND, 0, 0)
    pdu_put_addr(var p, var a)
    let _x = pdu_put(var p, 2)
    let _y = pdu_put(var p, 1)
    let _z = pdu_put(var p, 6)
    pdu_finish(var p)
    test.assert_eq(p.n, 11)
    test.assert_eq(pdu_len(var p), 9)
    test.assert_eq(pdu_get(var p, 1), 9)
    test.assert_eq(pdu_get(var p, 2), 1)
    test.assert_eq(pdu_get(var p, 7), 6)
    test.assert_eq(pdu_get(var p, 11), -1)

@test
fn test_put_stops_when_the_pdu_is_full()
    var p = pdu_new()
    for _ in 0..PDU_OCTETS
        test.assert(pdu_put(var p, 1))
    test.assert(not pdu_put(var p, 1))
    test.assert_eq(p.n, PDU_OCTETS)

@test
fn test_address_compare_and_copy()
    var p = pdu_new()
    var a = test_addr(0x10)
    pdu_begin(var p, SCAN_REQ, 0, 0)
    pdu_put_addr(var p, var a)
    var b = test_addr(0x20)
    pdu_put_addr(var p, var b)
    pdu_finish(var p)
    test.assert(pdu_addr_is(var p, 0, var a))
    test.assert(pdu_addr_is(var p, 6, var b))
    test.assert(not pdu_addr_is(var p, 0, var b))
    var c = test_addr(0)
    pdu_addr_get(var p, 6, var c)
    test.assert_eq(c[0] as Int, 0x20)
    test.assert_eq(c[5] as Int, 0x25)

@test
fn test_well_formed_checks_each_types_length()
    var p = pdu_new()
    var a = test_addr(1)
    pdu_begin(var p, ADV_IND, 0, 0)
    pdu_put_addr(var p, var a)
    pdu_finish(var p)
    test.assert(pdu_well_formed(var p, 8))
    test.assert(not pdu_well_formed(var p, 9))
    test.assert(not pdu_well_formed(var p, 1))
    // An ADV_IND with a payload of 5 is too short.
    p.b[1] = 5
    test.assert(not pdu_well_formed(var p, 7))
    // ADV_DIRECT_IND is exactly 12, SCAN_REQ exactly 12, CONNECT_IND 34.
    pdu_begin(var p, ADV_DIRECT_IND, 0, 0)
    pdu_put_addr(var p, var a)
    pdu_put_addr(var p, var a)
    pdu_finish(var p)
    test.assert(pdu_well_formed(var p, 14))
    p.b[0] = SCAN_REQ as u8
    test.assert(pdu_well_formed(var p, 14))
    p.b[0] = CONNECT_IND as u8
    test.assert(not pdu_well_formed(var p, 14))
    p.b[0] = 7
    test.assert(not pdu_well_formed(var p, 14))

@test
fn test_type_classes()
    test.assert(type_is_advertising(ADV_IND))
    test.assert(type_is_advertising(ADV_DIRECT_IND))
    test.assert(type_is_advertising(ADV_NONCONN_IND))
    test.assert(type_is_advertising(ADV_SCAN_IND))
    test.assert(not type_is_advertising(SCAN_REQ))
    test.assert(type_is_scannable(ADV_IND))
    test.assert(type_is_scannable(ADV_SCAN_IND))
    test.assert(not type_is_scannable(ADV_NONCONN_IND))
    test.assert(not type_is_scannable(ADV_DIRECT_IND))

@test
fn test_report_event_types_follow_the_hci_numbering()
    test.assert_eq(report_event_type(ADV_IND), 0)
    test.assert_eq(report_event_type(ADV_DIRECT_IND), 1)
    test.assert_eq(report_event_type(ADV_SCAN_IND), 2)
    test.assert_eq(report_event_type(ADV_NONCONN_IND), 3)
    test.assert_eq(report_event_type(SCAN_RSP), 4)
    test.assert_eq(report_event_type(SCAN_REQ), -1)
    test.assert_eq(report_event_type(CONNECT_IND), -1)

@test
fn test_airtime_of_a_full_advertisement()
    // 2 header octets and 6 + 31 payload octets: 39 octets, 47 with the
    // preamble, access address and CRC, 376 microseconds.
    test.assert_eq(airtime_us(39), 376)
    test.assert_eq(airtime_us(14), 176)
