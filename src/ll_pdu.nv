// orbit/noble-radio/src/ll_pdu.nv — the legacy advertising channel PDUs: the header
// bits, a fixed buffer for one PDU, and the builders and parsers of the
// seven PDU types the legacy Link Layer sends and receives.
//
// [Vol 6] Part B, Section 2.3: an advertising channel PDU is a 2-octet
// header and a payload of 0 to 37 octets.  Octet 0 of the header holds the
// PDU Type in bits 0 to 3, ChSel in bit 5, TxAdd in bit 6 and RxAdd in bit 7;
// octet 1 holds the payload length.  The radio's S0 field is octet 0 and its
// LENGTH field is octet 1, so a `Pdu` is the bytes the radio sends or fills,
// header first.
//
// An address is 6 octets, least significant octet first, as HCI and the air
// carry it.
//
// The state is a value with inline storage; no function here allocates.

// The functions below take a PDU as a `var` parameter even where they only read
// it, which passes its address.  A plain parameter is a copy, and a copy of a
// struct of this size on every call costs time and stack.

// PDU types, [Vol 6] Part B, Section 2.3.

// Connectable and scannable undirected advertising ([Vol 6] Part B, Section 2.3.1.1).
pub const ADV_IND = 0
// Connectable directed advertising ([Vol 6] Part B, Section 2.3.1.2).
pub const ADV_DIRECT_IND = 1
// Non-connectable undirected advertising ([Vol 6] Part B, Section 2.3.1.3).
pub const ADV_NONCONN_IND = 2
// A scanner asks an advertiser for its scan response ([Vol 6] Part B, Section 2.3.2.1).
pub const SCAN_REQ = 3
// The advertiser's answer to a SCAN_REQ ([Vol 6] Part B, Section 2.3.2.2).
pub const SCAN_RSP = 4
// An initiator asks an advertiser for a connection ([Vol 6] Part B, Section 2.3.3.1).
pub const CONNECT_IND = 5
// Scannable undirected advertising ([Vol 6] Part B, Section 2.3.1.4).
pub const ADV_SCAN_IND = 6

// The longest payload of a legacy advertising PDU.
pub const PAYLOAD_MAX = 37
// The octets of the longest advertising PDU: the header and `PAYLOAD_MAX`.
pub const PDU_OCTETS = 39

// The octets of an address.
pub const ADDR_OCTETS = 6
// The payload of a SCAN_REQ: ScanA and AdvA.
pub const SCAN_REQ_PAYLOAD = 12
// The payload of an ADV_DIRECT_IND: AdvA and TargetA.
pub const DIRECT_PAYLOAD = 12
// The payload of a CONNECT_IND: InitA, AdvA and the 22 octets of LLData.
pub const CONNECT_PAYLOAD = 34

// The most advertising or scan response data octets a legacy PDU carries.
pub const DATA_MAX = 31

// Bit 5 of header octet 0.  ChSel says the sender supports channel selection algorithm #2 (an advertisement) or that
// the connection uses it (a CONNECT_IND).
pub const CHSEL = 0x20
// Bit 6 of header octet 0: the sender's address is random.
pub const TXADD = 0x40
// Bit 7 of header octet 0: the addressee's address is random.
pub const RXADD = 0x80

// A public device address, as HCI numbers address types.
pub const ADDR_PUBLIC = 0
// A random device address, as HCI numbers address types.
pub const ADDR_RANDOM = 1

// `b` holds the PDU, header first, in 260 octets: the longest Data Physical
// Channel PDU with the Data Length Extension is a header of 2 octets, a payload of
// 251 and the MIC of 4, 257 octets, rounded up to whole words.  An advertising PDU
// is at most 39 octets (`PDU_OCTETS`).  `n` is the octets written.
pub @value
struct Pdu
    b: Vec[u8; 260]
    n: Int

// The octets a `Pdu` holds.
pub const PDU_CAP = 260

// The octets of the longest data PDU: the header, 251 octets of payload and the MIC.
pub const DATA_OCTETS_MAX = 257

// An empty PDU.
pub @tier(embedded)
fn pdu_new() -> Pdu
    var p = Pdu { b: Vec.new(), n: 0 }
    for _ in 0..260
        let _a = p.b.push(0)
    p

// Back to empty.
pub @tier(embedded)
fn pdu_clear(var p: Pdu)
    p.n = 0

// Append one octet.  False when the PDU is full.
pub @tier(embedded)
fn pdu_put(var p: Pdu, v: Int) -> Bool
    if p.n >= PDU_OCTETS
        return false
    p.b[p.n] = (v & 0xFF) as u8
    p.n = p.n + 1
    true

// Append one octet of a data PDU, which may be longer than an advertising PDU.
// False when the PDU is full.
pub @tier(embedded)
fn pdu_put_data(var p: Pdu, v: Int) -> Bool
    if p.n >= DATA_OCTETS_MAX
        return false
    p.b[p.n] = (v & 0xFF) as u8
    p.n = p.n + 1
    true

// Octet `i` of the PDU, -1 past what was written.
pub @tier(embedded)
fn pdu_get(var p: Pdu, i: Int) -> Int
    if i < 0 or i >= p.n
        -1
    else
        p.b[i] as Int

// Start a PDU of `ty`: the header with the address type bits, and the length
// octet left at zero.  `tx_add` and `rx_add` are 0 or 1.
pub @tier(embedded)
fn pdu_begin(var p: Pdu, ty: Int, tx_add: Int, rx_add: Int)
    p.n = 0
    let _a = pdu_put(var p, ty | (tx_add * TXADD) | (rx_add * RXADD))
    let _b = pdu_put(var p, 0)

// Write the payload length into the header.
pub @tier(embedded)
fn pdu_finish(var p: Pdu)
    if p.n >= 2
        p.b[1] = (p.n - 2) as u8

// Append the six octets of `a`.
pub @tier(embedded)
fn pdu_put_addr(var p: Pdu, var a: Vec[u8; 6])
    for i in 0..ADDR_OCTETS
        let _a = pdu_put(var p, a[i] as Int)

// The PDU Type of a received PDU.
pub @tier(embedded)
fn pdu_type(var p: Pdu) -> Int
    p.b[0] as Int & 0x0F

// The payload length the header claims.
pub @tier(embedded)
fn pdu_len(var p: Pdu) -> Int
    p.b[1] as Int & 0x3F

// TxAdd and RxAdd, 0 or 1.
pub @tier(embedded)
fn pdu_tx_add(var p: Pdu) -> Int
    if (p.b[0] as Int & TXADD) != 0
        1
    else
        0

// RxAdd of the header, 0 or 1: whether the addressee's address is random.
pub @tier(embedded)
fn pdu_rx_add(var p: Pdu) -> Int
    if (p.b[0] as Int & RXADD) != 0
        1
    else
        0

// Whether the six octets at payload offset `off` equal `a`.
pub @tier(embedded)
fn pdu_addr_is(var p: Pdu, off: Int, var a: Vec[u8; 6]) -> Bool
    for i in 0..ADDR_OCTETS
        if p.b[2 + off + i] != a[i]
            return false
    true

// Copy the six octets at payload offset `off` into `a`.
pub @tier(embedded)
fn pdu_addr_get(var p: Pdu, off: Int, var a: Vec[u8; 6])
    for i in 0..ADDR_OCTETS
        a[i] = p.b[2 + off + i]

// Whether a received PDU of type `ty` has a payload length that type allows,
// and the header's length agrees with the octets received (`got`, the PDU
// octets including the header).
pub @tier(embedded)
fn pdu_well_formed(var p: Pdu, got: Int) -> Bool
    if got < 2
        return false
    let len = pdu_len(var p)
    if len + 2 != got
        return false
    let ty = pdu_type(var p)
    if ty == ADV_IND or ty == ADV_SCAN_IND or ty == ADV_NONCONN_IND or ty == SCAN_RSP
        return len >= ADDR_OCTETS and len <= PAYLOAD_MAX
    if ty == ADV_DIRECT_IND
        return len == DIRECT_PAYLOAD
    if ty == SCAN_REQ
        return len == SCAN_REQ_PAYLOAD
    if ty == CONNECT_IND
        return len == CONNECT_PAYLOAD
    false

// Whether the type is one an advertiser sends on the advertising channels.
pub @tier(embedded)
fn type_is_advertising(ty: Int) -> Bool
    ty == ADV_IND or ty == ADV_DIRECT_IND or ty == ADV_NONCONN_IND or ty == ADV_SCAN_IND

// Whether a scanner answers the type with a SCAN_REQ.
pub @tier(embedded)
fn type_is_scannable(ty: Int) -> Bool
    ty == ADV_IND or ty == ADV_SCAN_IND

// The HCI advertising report Event_Type of the PDU type: 0 to 4 as
// [Vol 4] Part E, Section 7.7.65.2 numbers them, -1 for a type the report
// does not carry.
pub @tier(embedded)
fn report_event_type(ty: Int) -> Int
    match ty
        0 => 0
        1 => 1
        6 => 2
        2 => 3
        4 => 4
        _ => -1

// The microseconds a PDU of `n` octets (header included) takes on the LE 1M
// PHY: the preamble (1 octet), the access address (4) and the CRC (3), at
// 8 microseconds an octet.
pub @tier(embedded)
fn airtime_us(n: Int) -> Int
    (n + 8) * 8
