// orbit/noble-radio/src/ll_phy.nv — the physical layers of the Link Layer and what a
// packet costs on each: LE 1M, LE 2M and LE Coded, the time a packet takes on
// air, and how many payload octets a time allows.
//
// [Vol 6] Part A.  A packet is the preamble, the access address, the PDU (the
// 2-octet header, the payload and the MIC of an encrypted PDU) and the CRC of 3
// octets.  The PHY changes the symbol rate and the preamble:
//
//   LE 1M     8 microseconds an octet; a preamble of 1 octet
//   LE 2M     4 microseconds an octet; a preamble of 2 octets
//   LE Coded  the preamble (80 microseconds), the access address (256) and the
//             coding indicator CI (16) and the first termination TERM1 (24) at
//             S=8 whichever coding the PDU has; then the PDU and the CRC at S=8
//             (64 microseconds an octet) or S=2 (16 microseconds an octet), and
//             TERM2 (24 or 6 microseconds)
//
// A receiver finds the coding in CI, so only a transmitter chooses S=2 or S=8.
//
// The numbers of the PHYs are those of HCI (LE Read PHY, LE PHY Update Complete:
// 1, 2, 3), and `mask` is the bit field LE Set PHY and LL_PHY_REQ use (bit 0 for LE
// 1M, bit 1 for LE 2M, bit 2 for LE Coded).  `OPT_S2` and `OPT_S8` are the
// PHY_Options bits of LE Set PHY (bit 0 prefers S=2, bit 1 prefers S=8).
//
// Nothing here knows a chip: the ramp-ups and the delays of a radio belong to the
// backend of `Radio` (`ll_radio.nv`).  No function here allocates.

// The PHYs, as HCI numbers them: LE 1M, LE 2M and LE Coded.
pub const PHY_1M = 1
// LE 2M, 4 microseconds an octet.
pub const PHY_2M = 2
// LE Coded, at S=8 or S=2.
pub const PHY_CODED = 3

// The bit of LE 1M in a PHY mask, the bit field of LE Set PHY and LL_PHY_REQ.
pub const MASK_1M = 1
// The bit of LE 2M in a PHY mask.
pub const MASK_2M = 2
// The bit of LE Coded in a PHY mask.
pub const MASK_CODED = 4
// Every PHY of a mask.
pub const MASK_ALL = 7

// The PHY_Options of LE Set PHY: no preference of coding on LE Coded.
pub const OPT_NONE = 0
// The PHY_Options bit that prefers S=2 coding on LE Coded.
pub const OPT_S2 = 1
// The PHY_Options bit that prefers S=8 coding on LE Coded.
pub const OPT_S8 = 2

// The octets of the MIC of an encrypted data PDU.
pub const MIC_OCTETS = 4
// The payload a data PDU always has room for, 27 octets.
pub const PAYLOAD_MIN = 27
// The longest payload of a data PDU with the Data Length Extension, 251 octets.
pub const PAYLOAD_MAX = 251

// The times of the data length parameters are those of [Vol 6] Part B, Table 4.8.  The shortest, in microseconds: a
// packet of 27 octets on an uncoded PHY.
pub const TIME_MIN = 328
// The time of a packet of 251 octets on an uncoded PHY, in microseconds.
pub const TIME_UNCODED_MAX = 2120
// The time of a packet of 27 octets on LE Coded at S=8, in microseconds.
pub const TIME_CODED_MIN = 2704
// The time of a packet of 251 octets on LE Coded at S=8, in microseconds.
pub const TIME_MAX = 17040

// The lesser and the greater of two values.
pub @tier(embedded)
fn lesser(a: Int, b: Int) -> Int
    if a < b
        a
    else
        b

// The greater of two values.
pub @tier(embedded)
fn greater(a: Int, b: Int) -> Int
    if a > b
        a
    else
        b

// The bit of the mask of a PHY, 0 for a number that is none.
pub @tier(embedded)
fn mask_of(phy: Int) -> Int
    match phy
        1 => MASK_1M
        2 => MASK_2M
        3 => MASK_CODED
        _ => 0

// The PHY a mask of one bit names, 0 when it has none or more than one.
pub @tier(embedded)
fn phy_of_mask(mask: Int) -> Int
    match mask
        1 => PHY_1M
        2 => PHY_2M
        4 => PHY_CODED
        _ => 0

// Whether `phy` is a number of a PHY.
pub @tier(embedded)
fn phy_valid(phy: Int) -> Bool
    phy >= PHY_1M and phy <= PHY_CODED

// The microseconds from the first bit of a packet to the end of its access
// address, which the ADDRESS event of the radio marks: the preamble and the
// access address, and on the LE Coded PHY the coding indicator and TERM1 too
// (376 microseconds, as the radio of the nRF54L raises ADDRESS after them).
pub @tier(embedded)
fn aa_end_us(phy: Int) -> Int
    match phy
        2 => 24
        3 => 376
        _ => 40

// The microseconds a packet with a PDU of `n` octets (the header, the payload
// and the MIC) takes on `phy`; `s8` says the LE Coded PHY sends S=8, not S=2.
pub @tier(embedded)
fn air_us(phy: Int, s8: Bool, n: Int) -> Int
    if phy == PHY_2M
        return (n + 9) * 4
    if phy == PHY_CODED
        if s8
            return 376 + (n + 3) * 64 + 24
        return 376 + (n + 3) * 16 + 6
    (n + 8) * 8

// The most payload octets (without the MIC) that a packet of `us` microseconds
// carries on `phy`, with the 2-octet header and a MIC of 4 octets reserved, so that
// the answer holds for an encrypted PDU too.  -1 when not even an empty PDU fits.
pub @tier(embedded)
fn fit_octets(phy: Int, s8: Bool, us: Int) -> Int
    var n = 0
    if phy == PHY_2M
        n = us / 4 - 9
    else if phy == PHY_CODED
        if s8
            n = (us - 400) / 64 - 3
        else
            n = (us - 382) / 16 - 3
    else
        n = us / 8 - 8
    n - 2 - MIC_OCTETS

// Scanning (or initiating) on LE 1M and LE Coded takes turns in each interval: the LE 1M window, then the LE Coded
// window ([Vol 6] Part B, Section 4.4.3.1).  Windows that together are longer than the interval share it in proportion.
// The lengths, in the unit the arguments have, of the first and of the second window.
pub @satisfies("REQ-BLE-CTL-092")
@tier(embedded)
fn split_first(interval: Int, w1: Int, wc: Int) -> Int
    if w1 + wc <= interval
        return w1
    interval * w1 / (w1 + wc)

// The length of the second window of an interval shared by two, in the unit of the arguments; `split_first` gives the
// first.
pub @satisfies("REQ-BLE-CTL-092")
@tier(embedded)
fn split_second(interval: Int, w1: Int, wc: Int) -> Int
    if w1 + wc <= interval
        return wc
    interval - split_first(interval, w1, wc)

// The longest packet the Link Layer receives or sends on `phy`: a PDU of the
// longest payload and its MIC, at the slowest coding.
pub @tier(embedded)
fn air_max_us(phy: Int) -> Int
    air_us(phy, true, 2 + PAYLOAD_MAX + MIC_OCTETS)

// An empty PDU, 2 octets of header with no payload, takes this long.
pub @tier(embedded)
fn air_empty_us(phy: Int, s8: Bool) -> Int
    air_us(phy, s8, 2)

// The time the supported PHYs give a data length parameter of `us`, never above
// the range of Table 4.8 or below its minimum.
pub @tier(embedded)
fn clamp_time(us: Int) -> Int
    if us < TIME_MIN
        return TIME_MIN
    if us > TIME_MAX
        return TIME_MAX
    us
